  "glossary": [
    {
      "term": "键线式",
      "def": "省略碳和碳氢键、只画碳骨架与官能团的结构式",
      "chapterId": "ch01"
    },
    {
      "term": "同分异构体",
      "def": "分子式相同、结构不同的化合物",
      "chapterId": "ch01"
    },
    {
      "term": "构象",
      "def": "单键旋转形成的不同空间排列，不断键即可互变",
      "chapterId": "ch02"
    },
    {
      "term": "马氏规则",
      "def": "不对称烯烃与 HX 加成时 H 加在含氢较多的碳上",
      "chapterId": "ch03"
    },
    {
      "term": "芳香性",
      "def": "环状、平面、π 电子数为 4n+2 的体系具有的特殊稳定性",
      "chapterId": "ch04"
    },
    {
      "term": "手性碳",
      "def": "连有四个不同基团的碳原子",
      "chapterId": "ch04"
    },
    {
      "term": "对映异构体",
      "def": "互为镜像、不能重合的一对立体异构体",
      "chapterId": "ch04"
    },
    {
      "term": "外消旋体",
      "def": "等量对映异构体的混合物，旋光相互抵消",
      "chapterId": "ch04"
    }
  ],
