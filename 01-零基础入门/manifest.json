  "flashcards": [
    {
      "id": "f01",
      "chapterId": "ch01",
      "front": "物质怎么分类：一句话核心是什么？",
      "back": "分类只看两件事：里面是不是只有一种东西，以及它由几种元素组成。",
      "tags": [
        "ch01"
      ]
    },
    {
      "id": "f02",
      "chapterId": "ch01",
      "front": "物质怎么分类最容易错在哪？",
      "back": "冰水混合物是纯净物，不是混合物。",
      "tags": [
        "ch01",
        "易错"
      ]
    },
    {
      "id": "f03",
      "chapterId": "ch02",
      "front": "原子、分子、离子：一句话核心是什么？",
      "back": "化学反应只动最外层电子，原子核不变；带电与否看质子数和电子数是否相等。",
      "tags": [
        "ch02"
      ]
    },
    {
      "id": "f04",
      "chapterId": "ch02",
      "front": "原子、分子、离子最容易错在哪？",
      "back": "NaCl 固体不导电，但里面有离子，只是不能自由移动。",
      "tags": [
        "ch02",
        "易错"
      ]
    },
    {
      "id": "f05",
      "chapterId": "ch03",
      "front": "化学式与化合价：一句话核心是什么？",
      "back": "化学式是物质的配方标签：元素种类不能错，正负化合价代数和必须为零。",
      "tags": [
        "ch03"
      ]
    },
    {
      "id": "f06",
      "chapterId": "ch03",
      "front": "化学式与化合价最容易错在哪？",
      "back": "配平不能改化学式右下角的下标。",
      "tags": [
        "ch03",
        "易错"
      ]
    },
    {
      "id": "f07",
      "chapterId": "ch04",
      "front": "化学方程式与配平：一句话核心是什么？",
      "back": "方程式是化学反应的账单：反应前后每种元素的原子个数必须一模一样。",
      "tags": [
        "ch04"
      ]
    },
    {
      "id": "f08",
      "chapterId": "ch04",
      "front": "化学方程式与配平最容易错在哪？",
      "back": "有化合价变化时，先电子守恒，再数原子。",
      "tags": [
        "ch04",
        "易错"
      ]
    },
    {
      "id": "f09",
      "chapterId": "ch05",
      "front": "物质的量：一句话核心是什么？",
      "back": "摩尔把数不清的微粒换成可以称量的份数，1 mol 就是 6.02×10²³ 个。",
      "tags": [
        "ch05"
      ]
    },
    {
      "id": "f10",
      "chapterId": "ch05",
      "front": "物质的量最容易错在哪？",
      "back": "22.4 L/mol 只对气体、只在标准状况成立。",
      "tags": [
        "ch05",
        "易错"
      ]
    },
    {
      "id": "f11",
      "chapterId": "ch06",
      "front": "电解质与离子反应：一句话核心是什么？",
      "back": "离子方程式只留下真正参加反应的离子，但难溶物、气体、水、弱电解质不能拆。",
      "tags": [
        "ch06"
      ]
    },
    {
      "id": "f12",
      "chapterId": "ch06",
      "front": "电解质与离子反应最容易错在哪？",
      "back": "能导电的铜不是电解质，电解质必须是化合物。",
      "tags": [
        "ch06",
        "易错"
      ]
    },
    {
      "id": "f13",
      "chapterId": "ch07",
      "front": "氧化还原反应：一句话核心是什么？",
      "back": "升失氧、降得还：化合价升高、失电子、被氧化；降低、得电子、被还原。",
      "tags": [
        "ch07"
      ]
    },
    {
      "id": "f14",
      "chapterId": "ch07",
      "front": "氧化还原反应最容易错在哪？",
      "back": "氧化剂被还原，不是被氧化。",
      "tags": [
        "ch07",
        "易错"
      ]
    },
    {
      "id": "f15",
      "chapterId": "ch08",
      "front": "元素周期表与化学键：一句话核心是什么？",
      "back": "周期表按电子层数分行、按最外层电子数分列；原子靠凑成稳定电子结构成键。",
      "tags": [
        "ch08"
      ]
    },
    {
      "id": "f16",
      "chapterId": "ch08",
      "front": "元素周期表与化学键最容易错在哪？",
      "back": "NaOH 有共价键，但它是离子化合物。",
      "tags": [
        "ch08",
        "易错"
      ]
    },
    {
      "id": "f17",
      "chapterId": "ch09",
      "front": "反应速率与化学平衡：一句话核心是什么？",
      "back": "速率管多快，平衡管最终生成多少；催化剂只改速率，不改平衡。",
      "tags": [
        "ch09"
      ]
    },
    {
      "id": "f18",
