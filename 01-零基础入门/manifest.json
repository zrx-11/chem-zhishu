  "glossary": [
    {
      "term": "纯净物",
      "def": "只由一种物质组成、有固定化学式的体系",
      "chapterId": "ch01"
    },
    {
      "term": "电解质",
      "def": "在水溶液或熔融状态下能导电的化合物",
      "chapterId": "ch06"
    },
    {
      "term": "离子方程式",
      "def": "删去旁观离子后只保留实际参加反应离子的方程式",
      "chapterId": "ch06"
    },
    {
      "term": "氧化剂",
      "def": "得电子、化合价降低、被还原的物质",
      "chapterId": "ch07"
    },
    {
      "term": "还原剂",
      "def": "失电子、化合价升高、被氧化的物质",
      "chapterId": "ch07"
    },
    {
      "term": "物质的量",
      "def": "表示微粒集合份数的物理量，单位 mol",
      "chapterId": "ch05"
    },
    {
      "term": "摩尔质量",
      "def": "1 mol 物质的质量，单位 g/mol",
      "chapterId": "ch05"
    },
    {
      "term": "官能团",
      "def": "决定有机物化学性质的原子或原子团",
      "chapterId": "ch10"
    }
  ],
