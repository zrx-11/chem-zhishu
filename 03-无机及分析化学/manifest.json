  "flashcards": [
    {
      "id": "f01",
      "chapterId": "ch00",
      "front": "物质分类只看哪两件事？",
      "back": "是不是只有一种物质；由几种元素组成。",
      "tags": [
        "ch00"
      ]
    },
    {
      "id": "f02",
      "chapterId": "ch00",
      "front": "常见元素化合价怎么记？",
      "back": "H +1、O −2、Na/K +1、Ca/Mg/Ba +2、Al +3；化合物代数和为零。",
      "tags": [
        "ch00"
      ]
    },
    {
      "id": "f03",
      "chapterId": "ch00",
      "front": "离子方程式拆什么、不拆什么？",
      "back": "强酸强碱可溶盐拆；难溶物、气体、弱电解质、水不拆。",
      "tags": [
        "ch00"
      ]
    },
    {
      "id": "f04",
      "chapterId": "ch00",
      "front": "物质的量四个公式？",
      "back": "n=m/M、n=N/NA、n=V/Vm、c=n/V。",
      "tags": [
        "ch00"
      ]
    },
    {
      "id": "f05",
      "chapterId": "ch01",
      "front": "四个量子数各管什么？",
      "back": "n 主量子数管能层；l 管亚层形状；m 管轨道取向；ms 管自旋。",
      "tags": [
        "ch01"
      ]
    },
    {
      "id": "f06",
      "chapterId": "ch01",
      "front": "电子排布三原则？",
      "back": "能量最低、泡利不相容、洪特规则。",
      "tags": [
        "ch01"
      ]
    },
    {
      "id": "f07",
      "chapterId": "ch01",
      "front": "VSEPR 判断分子构型的第一步？",
      "back": "算中心原子价层电子对数，再看孤对电子数。",
      "tags": [
        "ch01"
      ]
    },
    {
      "id": "f08",
      "chapterId": "ch01",
      "front": "四类晶体是什么？",
      "back": "离子晶体、分子晶体、原子晶体、金属晶体。",
      "tags": [
        "ch01"
      ]
    },
    {
      "id": "f09",
      "chapterId": "ch02",
      "front": "速率方程一般形式？",
      "back": "v=k[A]^m[B]^n，m+n 为反应级数。",
      "tags": [
        "ch02"
      ]
    },
    {
      "id": "f10",
      "chapterId": "ch02",
      "front": "Arrhenius 公式？",
      "back": "k=A e^(-Ea/RT)，升温 k 增大。",
      "tags": [
        "ch02"
      ]
    },
    {
      "id": "f11",
      "chapterId": "ch02",
      "front": "Q 与 K 比较怎么判断方向？",
      "back": "Q<K 正向，Q=K 平衡，Q>K 逆向。",
      "tags": [
        "ch02"
      ]
    },
    {
      "id": "f12",
      "chapterId": "ch02",
      "front": "勒夏特列原理四句话？",
      "back": "增压向气少，升温向吸热，增浓向消耗，催化剂不移动。",
      "tags": [
        "ch02"
      ]
    },
    {
      "id": "f13",
      "chapterId": "ch03",
      "front": "卤素氧化性顺序？",
      "back": "F2>Cl2>Br2>I2；还原性 I->Br->Cl->F-。",
      "tags": [
        "ch03"
      ]
    },
    {
      "id": "f14",
      "chapterId": "ch03",
      "front": "SO2 和 SO3 的性质差异？",
      "back": "SO2 既有氧化性又有还原性；SO3 主要是酸性氧化物。",
      "tags": [
        "ch03"
      ]
    },
    {
      "id": "f15",
      "chapterId": "ch03",
      "front": "浓硝酸与稀硝酸和铜反应产物？",
