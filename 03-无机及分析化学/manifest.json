    },
    {
      "term": "物质的量浓度",
      "def": "单位体积溶液中所含溶质的物质的量，c=n/V",
      "chapterId": "ch00"
    },
    {
      "term": "稀释定律",
      "def": "稀释前后溶质物质的量不变，c1V1=c2V2",
      "chapterId": "ch00"
    },
    {
      "term": "原子序数",
