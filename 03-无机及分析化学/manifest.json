    {
      "id": "f29",
      "chapterId": "ch07",
      "front": "EDTA 与金属的配位比？",
      "back": "通常 1:1。",
      "tags": [
        "ch07"
      ]
    },
    {
      "id": "f30",
      "chapterId": "ch07",
      "front": "酸效应系数怎么定义？",
      "back": "αY(H)=cY/[Y4-]，≥1。",
      "tags": [
        "ch07"
      ]
    },
    {
      "id": "f31",
      "chapterId": "ch07",
      "front": "条件稳定常数公式？",
      "back": "lgK'=lgKf−lgαY(H)（只考虑酸效应）。",
      "tags": [
        "ch07"
      ]
    },
    {
      "id": "f32",
      "chapterId": "ch07",
      "front": "金属指示剂变色条件？",
      "back": "MIn 要比 MY 不稳定，EDTA 才能夺走 M。",
      "tags": [
        "ch07"
      ]
    },
    {
      "id": "f33",
      "chapterId": "ch08",
      "front": "标准电极电势是强度还是广度性质？",
      "back": "强度性质，与配平系数无关。",
      "tags": [
        "ch08"
      ]
    },
    {
      "id": "f34",
      "chapterId": "ch08",
      "front": "Nernst 方程？",
      "back": "E=E°+(0.0592/n)lg([Ox]/[Red])。",
      "tags": [
        "ch08"
      ]
    },
    {
      "id": "f35",
      "chapterId": "ch08",
      "front": "ΔG° 与 E° 关系？",
      "back": "ΔG°=−nFE°。",
      "tags": [
        "ch08"
      ]
    },
    {
      "id": "f36",
      "chapterId": "ch08",
      "front": "由 E° 求 K？",
      "back": "lgK=nE°/0.0592。",
      "tags": [
        "ch08"
      ]
    },
    {
      "id": "f37",
      "chapterId": "ch09",
      "front": "KMnO4 法为什么用 H2SO4 不用 HCl？",
      "back": "Cl- 会被 MnO4- 氧化，消耗滴定剂。",
      "tags": [
        "ch09"
      ]
    },
    {
      "id": "f38",
      "chapterId": "ch09",
      "front": "K2Cr2O7 法指示剂？",
      "back": "二苯胺磺酸钠，终点无色变紫红。",
      "tags": [
        "ch09"
      ]
    },
    {
      "id": "f39",
      "chapterId": "ch09",
      "front": "碘量法两种方式？",
      "back": "直接法测还原性物质；间接法测氧化性物质。",
      "tags": [
        "ch09"
      ]
    },
    {
      "id": "f40",
      "chapterId": "ch09",
      "front": "淀粉指示剂何时加？",
      "back": "接近终点时加，避免吸附 I2。",
      "tags": [
        "ch09"
      ]
    },
    {
      "id": "f41",
      "chapterId": "ch10",
      "front": "AB 型与 A2B 型溶解度公式？",
      "back": "AB 型 s=√Ksp；A2B/AB2 型 s=∛(Ksp/4)。",
      "tags": [
        "ch10"
      ]
    },
    {
      "id": "f42",
      "chapterId": "ch10",
      "front": "分步沉淀看什么？",
      "back": "看开始沉淀所需沉淀剂浓度，不是只看 Ksp。",
      "tags": [
        "ch10"
      ]
    },
    {
      "id": "f43",
      "chapterId": "ch10",
      "front": "三种沉淀滴定法条件？",
      "back": "莫尔法中性/弱碱；佛尔哈德法酸性；法扬司法吸附指示剂。",
      "tags": [
        "ch10"
      ]
    },
    {
      "id": "f44",
      "chapterId": "ch10",
      "front": "换算因数怎么写？",
      "back": "F=aM(待测)/bM(称量形式)。",
      "tags": [
        "ch10"
      ]
    },
    {
      "id": "f45",
      "chapterId": "ch11",
      "front": "A、T 关系？",
      "back": "A=−lgT，T=10^-A。",
      "tags": [
        "ch11"
      ]
    },
    {
      "id": "f46",
      "chapterId": "ch11",
      "front": "朗伯-比尔定律？",
      "back": "A=εbc。",
      "tags": [
        "ch11"
      ]
    },
    {
      "id": "f47",
      "chapterId": "ch11",
      "front": "为什么选 λmax？",
      "back": "灵敏度最高，波长微小变化影响小。",
      "tags": [
        "ch11"
      ]
    },
    {
      "id": "f48",
      "chapterId": "ch11",
      "front": "偏离比尔定律的仪器原因？",
      "back": "单色光不纯、杂散光、吸收池不匹配。",
      "tags": [
        "ch11"
      ]
    },
    {
      "id": "f49",
      "chapterId": "ch12",
      "front": "参比电极与指示电极区别？",
      "back": "参比电势固定；指示电势随待测离子变。",
      "tags": [
        "ch12"
      ]
    },
    {
      "id": "f50",
      "chapterId": "ch12",
      "front": "玻璃电极 pH 响应？",
      "back": "E=K−0.0592pH（25℃）。",
      "tags": [
        "ch12"
      ]
    },
    {
      "id": "f51",
      "chapterId": "ch12",
      "front": "萃取率公式？",
      "back": "E=D/(D+V水/V有机)×100%。",
      "tags": [
        "ch12"
      ]
    },
    {
      "id": "f52",
      "chapterId": "ch12",
      "front": "分离方法四类？",
      "back": "沉淀、萃取、离子交换、色谱。",
      "tags": [
        "ch12"
      ]
    }
  ],
