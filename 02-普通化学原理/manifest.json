      "id": "f01",
      "chapterId": "ch01",
      "front": "气体：一句话核心是什么？",
      "back": "理想气体把分子当成没有体积、彼此不吸引的质点，pV=nRT 是这种假设下的状态方程。",
      "tags": [
        "ch01"
      ]
    },
    {
      "id": "f02",
      "chapterId": "ch01",
      "front": "气体最容易错在哪？",
      "back": "温度必须用 K，不能用摄氏度。",
      "tags": [
        "ch01",
        "易错"
      ]
    },
    {
      "id": "f03",
      "chapterId": "ch02",
      "front": "热力学第一定律与焓：一句话核心是什么？",
      "back": "能量守恒：体系内能的改变，等于它吸收的热加上外界对它做的功。",
      "tags": [
        "ch02"
      ]
    },
    {
      "id": "f04",
      "chapterId": "ch02",
      "front": "热力学第一定律与焓最容易错在哪？",
      "back": "焓不是热，只有恒压且只做体积功时 ΔH 才等于 Qp。",
      "tags": [
        "ch02",
        "易错"
      ]
    },
    {
      "id": "f05",
      "chapterId": "ch03",
      "front": "热化学与盖斯定律：一句话核心是什么？",
      "back": "反应热只由始末态决定，可以把已知反应像代数式一样相加。",
      "tags": [
        "ch03"
      ]
    },
    {
      "id": "f06",
      "chapterId": "ch03",
      "front": "热化学与盖斯定律最容易错在哪？",
      "back": "热化学方程式必须标物质状态。",
      "tags": [
        "ch03",
        "易错"
      ]
    },
    {
      "id": "f07",
      "chapterId": "ch04",
      "front": "熵与吉布斯自由能：一句话核心是什么？",
      "back": "自发性由放热和熵增共同决定，ΔG = ΔH - TΔS 把两者合成一个判据。",
      "tags": [
        "ch04"
      ]
    },
    {
      "id": "f08",
      "chapterId": "ch04",
      "front": "熵与吉布斯自由能最容易错在哪？",
      "back": "ΔG<0 只说明方向，不说明速率。",
      "tags": [
        "ch04",
        "易错"
      ]
    },
    {
      "id": "f09",
      "chapterId": "ch05",
      "front": "化学平衡：一句话核心是什么？",
      "back": "平衡常数 K 只随温度变化；Q 与 K 的比较告诉你反应往哪边走。",
      "tags": [
        "ch05"
      ]
    },
    {
      "id": "f10",
      "chapterId": "ch05",
      "front": "化学平衡最容易错在哪？",
      "back": "催化剂不改变 K。",
      "tags": [
        "ch05",
        "易错"
      ]
    },
    {
      "id": "f11",
      "chapterId": "ch06",
      "front": "酸碱电离平衡与缓冲溶液：一句话核心是什么？",
      "back": "酸碱反应是质子转移；弱酸的 Ka 与共轭碱的 Kb 通过 Kw 联系。",
      "tags": [
        "ch06"
      ]
    },
    {
      "id": "f12",
      "chapterId": "ch06",
      "front": "酸碱电离平衡与缓冲溶液最容易错在哪？",
      "back": "pH=7 只在 25℃ 是中性。",
      "tags": [
        "ch06",
        "易错"
      ]
    },
    {
      "id": "f13",
      "chapterId": "ch07",
      "front": "沉淀溶解平衡：一句话核心是什么？",
      "back": "难溶电解质并非完全不溶，Ksp 是溶解与沉淀平衡的定量表达。",
      "tags": [
        "ch07"
      ]
    },
    {
      "id": "f14",
      "chapterId": "ch07",
      "front": "沉淀溶解平衡最容易错在哪？",
      "back": "Ksp 小的先沉淀，不是大的先沉淀。",
      "tags": [
        "ch07",
        "易错"
      ]
    },
    {
      "id": "f15",
      "chapterId": "ch08",
      "front": "氧化还原与电化学：一句话核心是什么？",
      "back": "氧化还原是电子转移；原电池把这种转移拆成两半，让电子走外电路做功。",
      "tags": [
        "ch08"
      ]
    },
    {
      "id": "f16",
      "chapterId": "ch08",
      "front": "氧化还原与电化学最容易错在哪？",
      "back": "原电池负极是阳极（氧化），别和电解池混。",
      "tags": [
        "ch08",
        "易错"
      ]
    },
    {
      "id": "f17",
      "chapterId": "ch09",
      "front": "化学反应速率：一句话核心是什么？",
      "back": "速率由活化能和碰撞频率决定；催化剂降低能垒，不改平衡。",
      "tags": [
        "ch09"
      ]
    },
    {
      "id": "f18",
      "chapterId": "ch09",
      "front": "化学反应速率最容易错在哪？",
      "back": "反应级数不一定等于方程式系数。",
      "tags": [
        "ch09",
        "易错"
      ]
    },
    {
      "id": "f19",
      "chapterId": "ch10",
      "front": "原子结构：一句话核心是什么？",
      "back": "电子没有确定轨道，只有概率分布；量子数描述这种分布的形状、方向和能量。",
      "tags": [
        "ch10"
      ]
    },
    {
      "id": "f20",
      "chapterId": "ch10",
      "front": "原子结构最容易错在哪？",
      "back": "Cr、Cu 的排布是半充满/全充满特例。",
      "tags": [
        "ch10",
        "易错"
      ]
    },
    {
      "id": "f21",
      "chapterId": "ch11",
      "front": "化学键与分子结构：一句话核心是什么？",
      "back": "分子形状由中心原子周围电子对互相排斥决定；杂化轨道是为成键重组的轨道。",
      "tags": [
        "ch11"
      ]
    },
    {
      "id": "f22",
      "chapterId": "ch11",
      "front": "化学键与分子结构最容易错在哪？",
      "back": "有极性键的分子不一定有极性。",
      "tags": [
        "ch11",
        "易错"
      ]
    },
    {
      "id": "f23",
      "chapterId": "ch12",
      "front": "晶体结构与配位化合物：一句话核心是什么？",
      "back": "晶体性质由构成粒子和粒子间作用力决定；配合物是中心离子与配体通过配位键结合的整体。",
      "tags": [
        "ch12"
      ]
    },
    {
      "id": "f24",
      "chapterId": "ch12",
      "front": "晶体结构与配位化合物最容易错在哪？",
      "back": "配位数不一定等于配体个数。",
      "tags": [
        "ch12",
        "易错"
      ]
    }
  ],
  "companion": "学习伴侣.html"
}