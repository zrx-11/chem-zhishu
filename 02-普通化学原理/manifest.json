  "glossary": [
    {
      "term": "状态函数",
      "def": "只由体系当前状态决定、与路径无关的物理量",
      "chapterId": "ch02"
    },
    {
      "term": "焓",
      "def": "H = U + pV，恒压热等于 ΔH",
      "chapterId": "ch02"
    },
    {
      "term": "熵",
      "def": "体系混乱度的量度，单位 J/(mol·K)",
      "chapterId": "ch04"
    },
    {
      "term": "吉布斯自由能",
      "def": "G = H - TS，恒温恒压下 ΔG<0 自发",
      "chapterId": "ch04"
    },
    {
      "term": "平衡常数",
      "def": "平衡时生成物浓度幂之积与反应物浓度幂之积的比值",
      "chapterId": "ch05"
    },
    {
      "term": "缓冲溶液",
      "def": "能抵抗少量酸碱、pH 基本不变的溶液",
      "chapterId": "ch06"
    },
    {
      "term": "溶度积",
      "def": "难溶电解质饱和溶液中离子浓度幂之积",
      "chapterId": "ch07"
    },
    {
      "term": "标准电极电势",
      "def": "电极相对标准氢电极的电势",
      "chapterId": "ch08"
    },
    {
      "term": "活化能",
      "def": "反应物分子变成活化分子所需的最小能量",
      "chapterId": "ch09"
    },
    {
      "term": "杂化",
      "def": "原子轨道重新组合成能量相同、方向更合理的新轨道",
      "chapterId": "ch11"
    }
  ],
